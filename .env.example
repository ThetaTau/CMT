# CMT environment variable template (placeholders only — never commit real secrets).
# Production is deployed on PythonAnywhere; these are exported from the virtualenv
# `postactivate` file and/or the WSGI file. See docs/deploy.md.

# --- Core Django ---
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-me-generate-a-50+-char-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=cmt.thetatau.org,cmt.thetatau.info
DJANGO_ADMIN_URL=some-unguessable-admin-path/
# Comma-separated absolute origins for CSRF (Django 4.2 requires scheme).
DJANGO_CSRF_TRUSTED_ORIGINS=https://cmt.thetatau.org,https://cmt.thetatau.info
# HSTS max-age in seconds (default 31536000 = 1 year).
DJANGO_SECURE_HSTS_SECONDS=31536000

# --- Database ---
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME
CONN_MAX_AGE=60

# --- Cache ---
REDIS_URL=redis://127.0.0.1:6379

# --- Email (Mailjet via django-anymail) ---
DJANGO_EMAIL_LIVE=True
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# HTTP basic-auth "user:pass" that secures the Mailjet tracking webhook.
ANYMAIL_WEBHOOK_SECRET=

# --- Error monitoring ---
ROLLBAR_ACCESS=

# --- Captcha ---
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=
BYPASS_CAPTCHA=False

# --- Google Cloud Storage / APIs ---
DJANGO_GCP_STORAGE_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=secrets/your-service-account.json
GOOGLE_API_KEY=

# --- Integrations (optional) ---
MAILERLITE_API_KEY=
MOOSEND_API_KEY=
METABASE_SECRET_KEY=
LMS_ID=
LMS_SECRET=
ED_ID=
ED_SECRET=
ED_HOST=https://ed.thetatau.org

# --- Central Office / people ---
EXECUTIVE_DIRECTOR=first.last@thetatau.org
