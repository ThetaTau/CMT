# CMT environment variable template (placeholders only — never commit real secrets).
# Production is deployed on PythonAnywhere; these are exported from the virtualenv
# `postactivate` file and/or the WSGI file. See docs/deploy.md.

# --- Core Django ---
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-me-generate-a-50+-char-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=cmt.thetatau.org,cmt.thetatau.info
DJANGO_ADMIN_URL=some-unguessable-admin-path/
# Comma-separated absolute origins for CSRF (Django 4.2 requires scheme).
DJANGO_CSRF_TRUSTED_ORIGINS=https://cmt.thetatau.org,https://cmt.thetatau.info
# HSTS max-age in seconds (default 31536000 = 1 year).
DJANGO_SECURE_HSTS_SECONDS=31536000

# --- Database ---
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME
CONN_MAX_AGE=60

# --- Cache ---
REDIS_URL=redis://127.0.0.1:6379

# --- Email (Mailjet via django-anymail) ---
DJANGO_EMAIL_LIVE=True
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# HTTP basic-auth "user:pass" that secures the Mailjet tracking webhook.
ANYMAIL_WEBHOOK_SECRET=

# --- Error monitoring ---
ROLLBAR_ACCESS=

# --- Captcha ---
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=
BYPASS_CAPTCHA=False

# --- Google Cloud Storage / APIs ---
DJANGO_GCP_STORAGE_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=secrets/your-service-account.json
GOOGLE_API_KEY=

# --- Integrations (optional) ---
MAILERLITE_API_KEY=
MOOSEND_API_KEY=
METABASE_SECRET_KEY=
LMS_ID=
LMS_SECRET=
ED_ID=
ED_SECRET=
ED_HOST=https://ed.thetatau.org
# Comma-separated Open edX course run(s) every user is enrolled in.
ED_COURSES=course-v1:ThetaTau+TT101+intro

# --- Central Office / people ---
# User.username of the Executive Director (fallback reviewer/recipient for workflows).
EXECUTIVE_DIRECTOR=first.last@thetatau.org

# --- Email open/click tracking (Mailjet native via anymail) ---
EMAIL_TRACK_OPENS=True
EMAIL_TRACK_CLICKS=True

# --- Contact sync (region/national officer -> Google / Microsoft Contacts) ---
# Each provider is shown only when BOTH its client id and secret are set.
# See docs/contact_sync_setup.md.
CONTACT_SYNC_GOOGLE_CLIENT_ID=
CONTACT_SYNC_GOOGLE_CLIENT_SECRET=
CONTACT_SYNC_MICROSOFT_CLIENT_ID=
CONTACT_SYNC_MICROSOFT_CLIENT_SECRET=
# common | organizations | consumers | a tenant GUID / verified domain.
CONTACT_SYNC_MICROSOFT_TENANT=common

# --- Events ---
# Auto-approve public events created by National Officers (else they queue).
EVENTS_AUTO_APPROVE_NATIONAL_PUBLIC=True

# --- Attendance ---
# majority | two_thirds | a float 0<x<=1
ATTENDANCE_QUORUM_RULE=majority
ATTENDANCE_GUEST_SEARCH_MIN_LENGTH=2
ATTENDANCE_GUEST_SEARCH_MAX_RESULTS=20
ATTENDANCE_MATCH_AUTO_ACCEPT_THRESHOLD=0.60

# --- Awards ---
# Show revoked awards (separate section) on public profiles.
AWARDS_SHOW_REVOKED=False

# --- Volunteer nominations ---
# Expiry (days) for tokenized nominee-consent links.
NOMINATION_CONSENT_TOKEN_MAX_AGE_DAYS=30
# Optional dotted path to a custom training-completion provider.
NOMINATION_TRAINING_PROVIDER=

# --- Backups (django-dbbackup) ---
# True = local filesystem; False = GCS bucket theta-tau-database.
DBBACKUP_LOCAL=True
DBBACKUP_STORAGE_LOCATION=database_backups

# --- Misc security / runtime toggles (defaults shown) ---
WEB_CONCURRENCY=4
CONN_MAX_AGE=60
DJANGO_ACCOUNT_ALLOW_REGISTRATION=False
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True
